# Copy to .env and adjust. All values are optional unless marked required.
# See README "Configuration reference" for details.

# Kafka / MSK bootstrap servers
KAFKA_BOOTSTRAP=localhost:9092
# Kafka topics
TICKS_TOPIC=market-ticks
SIGNALS_TOPIC=trade-signals
# Comma-separated symbols to simulate
SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY

# Streaming knobs
WATERMARK=2 minutes
WINDOW=5 minutes
SLIDE=1 minute
TRIGGER_SECONDS=30

# S3 bucket for bronze/silver/gold (required on AWS; use ./data locally)
S3_BUCKET=s3://my-quant-bucket
CHECKPOINT_ROOT=./checkpoints
GLUE_JOB_NAME=quant-streaming-job

# Backtesting
INITIAL_CAPITAL=100000
MAX_POSITION_PCT=0.1
COMMISSION_BPS=2
SLIPPAGE_BPS=1
